# ---- Server ----
PORT=3000
# The public https address people (and Instagram/TikTok) use to reach this server.
# Instagram downloads your media from here, and TikTok redirects back here after login.
PUBLIC_BASE_URL=https://social.example.com

# Password for the web interface (username defaults to "admin"). Always set this.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# true = simulate posting (nothing reaches the networks). Set to false when accounts are connected.
DRY_RUN=true

# ---- Facebook Page + Instagram (Meta Graph API) ----
# Run `npm run meta:setup -- <APP_ID> <APP_SECRET> <USER_TOKEN>` to get these values.
META_GRAPH_VERSION=v23.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional: defaults to FACEBOOK_PAGE_ACCESS_TOKEN
INSTAGRAM_ACCESS_TOKEN=

# ---- TikTok (Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Defaults to PUBLIC_BASE_URL/auth/tiktok/callback. Register the same URL in the TikTok developer portal.
TIKTOK_REDIRECT_URI=
# SELF_ONLY until TikTok audits your app; then PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS or FOLLOWER_OF_CREATOR.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ---- Cloudflare Tunnel (public https address) ----
# Set up with: sh /opt/social-hub/deploy/enable-tunnel.sh (inside the container)
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
